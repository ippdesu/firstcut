# Absolute path to the activity root (the directory containing JPG/ and RAW/, if used).
PHOTO_DIR=/Users/your-name/Pictures/your-activity

# Optional AI model directory. Keep models out of the container image.
MODEL_DIR=/Users/your-name/firstcut-models

# On macOS/Linux, set these to the current user's numeric IDs before running Compose.
FIRSTCUT_UID=1000
FIRSTCUT_GID=1000

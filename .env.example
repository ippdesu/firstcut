# Absolute path to the activity root (the directory containing JPG/ and RAW/, if used).
PHOTO_DIR=/Users/your-name/Pictures/your-activity

# Persistent host directory for workspace state (cache, decisions, thumbnails, config).
# Survives `docker compose down`; workspaces are automatically isolated per PHOTO_DIR.
DATA_DIR=/Users/your-name/firstcut-data

# Optional AI model directory. Keep models out of the container image.
MODEL_DIR=/Users/your-name/firstcut-models

# On macOS/Linux, set these to the current user's numeric IDs before running Compose.
FIRSTCUT_UID=1000
FIRSTCUT_GID=1000

# Set to the output of: openssl rand -hex 32
FIRSTCUT_ACCESS_TOKEN=
FIRSTCUT_PUBLIC_URL=http://127.0.0.1:8787
